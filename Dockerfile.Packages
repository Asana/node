# Builds the native npm packages that LunaServer loads from node/gyp in codez against
# Asana's pointer-compressed Node build (node.tar.xz, downloaded from this branch's release).
#
# Addons built on the V8/NAN API must be compiled against our headers: prebuilt binaries for
# stock Node have the same NODE_MODULE_VERSION but a different V8 object layout, so they load
# and then crash. N-API addons (bcrypt, cld) are layout-independent but are built here too so
# the tarball stays self-contained.
#
# See Dockerfile.Node24 for why this builds on Ubuntu 22.04 with g++-12.
FROM ubuntu:22.04 AS base

ENV DEBIAN_FRONTEND=noninteractive

RUN set -e; \
    for i in 1 2 3 4 5; do \
        echo "Attempt $i: Setting up build environment..." && \
        apt-get update --allow-releaseinfo-change && \
        apt-get install -y --no-install-recommends --fix-missing \
            ca-certificates \
            curl \
            g++-12 \
            gcc-12 \
            git \
            make \
            python3 \
            xz-utils \
        && break || \
        (echo "Attempt $i failed! Sleeping 15s..." && sleep 15); \
    done
RUN rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100 && \
    update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 && \
    update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-12 100 && \
    update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-12 100
ENV CC=gcc-12 CXX=g++-12

WORKDIR /usr/src/node
COPY node.tar.xz .

RUN mkdir -p node-install && tar -C node-install -xJf node.tar.xz

ENV PATH="/usr/src/node/node-install/usr/local/bin:$PATH"
ENV NODE_DIR="/usr/src/node/node-install/usr/local"

RUN node -v && node -p "process.arch" && node -p "process.versions.modules" && \
    node -p "process.config.variables.v8_enable_pointer_compression"

RUN npm i --nodedir="$NODE_DIR" bcrypt@5.1.0
RUN npm i --nodedir="$NODE_DIR" cld@2.9.1
RUN npm i --nodedir="$NODE_DIR" unix-dgram@2.0.6

# Build @datadog/pprof from source against Asana custom Node.
# The npm package ships with "install: exit 0" and no C++ source (only prebuilts for stock
# Node), so we clone from GitHub to build the native binding against our pointer-compressed V8.
RUN npm i @datadog/pprof@5.8.0 --ignore-scripts
RUN git clone --branch v5.8.0 --depth 1 https://github.com/DataDog/pprof-nodejs.git /usr/src/pprof-source
WORKDIR /usr/src/pprof-source
RUN npm install --unsafe-perm --build-from-source
RUN npm install --unsafe-perm node-gyp
RUN node_modules/.bin/node-gyp rebuild --jobs=max --nodedir="$NODE_DIR"
# Replace the linux prebuilt with our pointer-compression-compatible binary.
# NODE_MODULE_VERSION and arch are read dynamically from the custom Node binary.
WORKDIR /usr/src/node
RUN ARCH=$(node -e "process.stdout.write(process.arch)") && \
    MODULES_VER=$(node -e "process.stdout.write(process.versions.modules)") && \
    PROFILER_NODE=$(find /usr/src/pprof-source/build/Release -name "*.node" | head -1) && \
    echo "Using profiler binary: $PROFILER_NODE" && \
    test -f "$PROFILER_NODE" && \
    cp "$PROFILER_NODE" \
       node_modules/@datadog/pprof/prebuilds/linuxglibc-${ARCH}/node-${MODULES_VER}.node

# Load every addon with the custom Node to catch ABI or missing-symbol problems here rather
# than in LunaServer.
RUN node -e " \
  const assert = require('assert'); \
  const bcrypt = require('bcrypt'); \
  assert(bcrypt.compareSync('x', bcrypt.hashSync('x', 4))); \
  assert.strictEqual(typeof require('cld').detect, 'function'); \
  require('unix-dgram').createSocket('unix_dgram').close(); \
  const pprof = require('@datadog/pprof'); \
  pprof.heap.start(512 * 1024, 64); \
  assert(Array.isArray(pprof.heap.profile().sample)); \
  pprof.heap.stop(); \
  pprof.time.start({ durationMillis: 1000 }); \
  const end = Date.now() + 200; while (Date.now() < end) {} \
  assert(Array.isArray(pprof.time.stop().sample)); \
  console.log('All native packages load'); \
"

RUN ls node_modules

CMD ["bash"]
