# Stage 1
FROM ubuntu:20.04 AS base

# Set non-interactive mode to avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install necessary dependencies
RUN apt-get update
RUN apt-get install -y software-properties-common
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test
RUN apt-get update
RUN apt-get install -y build-essential python3 python3-distutils g++-10 make curl git pkg-config libssl-dev libffi-dev libgmp-dev libtool autoconf automake cmake wget xz-utils unzip vim

# Copy local Node.js source into the image
WORKDIR /usr/src/node
COPY node.tar.xz .

RUN mkdir -p node-install && tar -C node-install -xJf node.tar.xz

ENV PATH="/usr/src/node/node-install/usr/local/bin:$PATH"

RUN which node
RUN node -v
RUN node -p "process.arch"
RUN echo -------------------

RUN npm i --nodedir="/usr/src/node/node-install/usr/local" bcrypt@5.1.0
RUN npm i --nodedir="/usr/src/node/node-install/usr/local" cld@2.9.1
RUN npm i --nodedir="/usr/src/node/node-install/usr/local" unix-dgram@2.0.6

# Build the pprof version required by dd-trace 5.116.0.
# Build native bindings against the existing pointer-compressed Node binary and headers.
RUN set -eu; \
    version=5.15.1; \
    package_root="/usr/src/pprof-packages/@datadog+pprof@${version}"; \
    install_root="/usr/src/pprof-install-${version}"; \
    npm install --prefix "$install_root" --ignore-scripts "@datadog/pprof@${version}"; \
    mkdir -p "$package_root/node_modules/@datadog"; \
    cp -a "$install_root/node_modules/@datadog/pprof" "$package_root/node_modules/@datadog/"; \
    git clone --branch "v${version}" --depth 1 https://github.com/DataDog/pprof-nodejs.git "/usr/src/pprof-source-${version}"; \
    cd "/usr/src/pprof-source-${version}"; \
    npm install --ignore-scripts; \
    npm install --ignore-scripts --no-save node-gyp@11.5.0; \
    node_modules/.bin/node-gyp rebuild --jobs=2 --nodedir=/usr/src/node/node-install/usr/local; \
    arch=$(node -p 'process.arch'); \
    modules_ver=$(node -p 'process.versions.modules'); \
    binding_path="prebuilds/linux-${arch}/dd_pprof.node.abi${modules_ver}.node"; \
    test -f "$package_root/node_modules/@datadog/pprof/$binding_path"; \
    cp build/Release/dd_pprof.node "$package_root/node_modules/@datadog/pprof/$binding_path"; \
    NODE_PATH="$install_root/node_modules" node -e 'const assert = require("assert"); const pprof = require(process.argv[1]); pprof.time.profile({durationMillis: 100}).then(profile => pprof.encode(profile)).then(bytes => { assert(bytes.length > 0); console.log("pprof native smoke passed:", process.argv[1]); }).catch(error => { console.error(error); process.exitCode = 1; });' "$package_root/node_modules/@datadog/pprof"; \
    cd /usr/src/node

WORKDIR /usr/src/node
CMD ["bash"]
