# Stage 1
FROM ubuntu:20.04 AS base

# Set non-interactive mode to avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install necessary dependencies
RUN apt-get update
RUN apt-get install -y software-properties-common
RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test
RUN apt-get update
RUN apt-get install -y build-essential python3 python3-distutils g++-10 make curl git pkg-config libssl-dev libffi-dev libgmp-dev libtool autoconf automake cmake wget xz-utils unzip vim

# Copy local Node.js source into the image
WORKDIR /usr/src/node
COPY node.tar.xz .

RUN mkdir -p node-install && tar -C node-install -xJf node.tar.xz

ENV PATH="/usr/src/node/node-install/usr/local/bin:$PATH"

RUN which node
RUN node -v
RUN node -p "process.arch"
RUN echo -------------------

RUN npm i --nodedir="/usr/src/node/node-install/usr/local" bcrypt@5.1.0
RUN npm i --nodedir="/usr/src/node/node-install/usr/local" cld@2.9.1
RUN npm i --nodedir="/usr/src/node/node-install/usr/local" unix-dgram@2.0.6

# Build @datadog/pprof from source against Asana custom Node.
# The npm package ships with "install: exit 0" and no C++ source (only prebuilts),
# so we clone from GitHub to build the native binding against our pointer-compressed V8.
# The standard prebuilts are ABI-incompatible with --experimental-enable-pointer-compression.
RUN npm i @datadog/pprof@5.15.1 --ignore-scripts
RUN git clone --branch v5.15.1 --depth 1 https://github.com/DataDog/pprof-nodejs.git /usr/src/pprof-source
WORKDIR /usr/src/pprof-source
RUN npm install --unsafe-perm --build-from-source
RUN npm install --unsafe-perm node-gyp
RUN node_modules/.bin/node-gyp rebuild --jobs=max --nodedir=/usr/src/node/node-install/usr/local
# Install our binary where node-gyp-build looks first (build/Release), and also over the stock
# prebuild for this ABI so that a loader that skips build/Release cannot pick a stock binary.
WORKDIR /usr/src/node
RUN set -e; \
    ARCH=$(node -p "process.arch"); \
    MODULES_VER=$(node -p "process.versions.modules"); \
    PKG=node_modules/@datadog/pprof; \
    PROFILER_NODE=$(find /usr/src/pprof-source/build/Release -maxdepth 1 -name "*.node" | head -1); \
    echo "Using profiler binary: $PROFILER_NODE"; \
    test -f "$PROFILER_NODE"; \
    mkdir -p "$PKG/build/Release"; \
    cp "$PROFILER_NODE" "$PKG/build/Release/"; \
    REPLACED=0; \
    for f in $(find "$PKG/prebuilds" -path "*linux*${ARCH}*" -name "*.node" | grep -E "(node-|abi)${MODULES_VER}\.node$" | grep -v musl); do \
        echo "Replacing prebuild $f"; cp "$PROFILER_NODE" "$f"; REPLACED=1; \
    done; \
    test "$REPLACED" = 1 || echo "No stock prebuild for ABI ${MODULES_VER}; build/Release only"

# Load every addon with the custom Node to catch ABI or missing-symbol problems here rather
# than in LunaServer.
RUN node -e " \
  const assert = require('assert'); \
  const bcrypt = require('bcrypt'); \
  assert(bcrypt.compareSync('x', bcrypt.hashSync('x', 4))); \
  assert.strictEqual(typeof require('cld').detect, 'function'); \
  require('unix-dgram').createSocket('unix_dgram').close(); \
  const pprof = require('@datadog/pprof'); \
  pprof.heap.start(512 * 1024, 64); \
  assert(Array.isArray(pprof.heap.profile().sample)); \
  pprof.heap.stop(); \
  pprof.time.start({ durationMillis: 1000 }); \
  const end = Date.now() + 200; while (Date.now() < end) {} \
  assert(Array.isArray(pprof.time.stop().sample)); \
  console.log('All native packages load'); \
"

RUN ls
RUN ls node_modules

CMD ["bash"]
